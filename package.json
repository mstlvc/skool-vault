{
  "name": "skool-vault",
  "productName": "Skool Vault",
  "version": "1.0.3",
  "description": "Download the Skool communities you belong to and browse them offline.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "fixture": "rolldown scripts/make-fixture.ts --format cjs --platform node --external ffmpeg-static --external electron -o out-scripts/make-fixture.js && node out-scripts/make-fixture.js test-library",
    "demo": "node scripts/make-demo.mjs",
    "icon": "python scripts/make-icon.py"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "daisyui": "^5.7.50",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "author": {
    "name": "Skool Vault contributors"
  }
}
